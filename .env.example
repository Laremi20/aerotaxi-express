# Variables de entorno de AeroTaxi Express (Informe U2, Tabla 19).
# Copia este archivo a .env.local y completa los valores. Nunca subas valores reales al repositorio.

# --- Públicas (se incluyen en el bundle del navegador) ---
NEXT_PUBLIC_SUPABASE_URL=
# Llave anónima: es pública, la protección real está en las políticas RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# No se usa todavía: sin Google Maps Platform por ahora (decisión del 2-nov-2026).
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# --- Solo servidor (secretas; nunca con prefijo NEXT_PUBLIC_) ---
# Para POST /api/conductores (invitación por correo).
SUPABASE_SERVICE_ROLE_KEY=
# No se usa todavía: Routes API se agregará después en /api/rutas (decisión del 2-nov-2026).
GOOGLE_MAPS_SERVER_KEY=

# --- Aplicación ---
# development | preview | production
APP_ENV=
# Versión SemVer informada por GET /api/health.
APP_VERSION=
